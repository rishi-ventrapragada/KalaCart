# KalaCart Backend Environment Variables
# Copy to .env and fill values - NEVER commit .env

# App
APP_NAME=KalaCart API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-secure-random-string
CORS_ORIGINS=http://localhost:3000,http://10.0.2.2:8000

# Supabase (PostgreSQL + Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Firebase Admin SDK (Phone OTP verification)
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
# Or inline JSON string
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

# OpenRouter / OpenCode (AI Models)
# The unified artisan agent (app/agent/) uses ONLY OpenRouter ":free" models,
# so the three AI features cost nothing per token. One key powers all of them.
OPENROUTER_API_KEY=sk-or-v1-xxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Per-feature models for the catalog / pricing / image endpoints.
# Held to ":free" slugs by decision D-9 — do not swap these for paid models
# without revisiting that decision.
QWEN_MODEL=google/gemma-4-31b-it:free
DEEPSEEK_MODEL=deepseek/deepseek-chat
VISION_MODEL=google/gemma-4-31b-it:free

# Sarvam AI — speech-to-text for voice notes in Indian languages.
# NOTE: Sarvam is a PAID speech service and is not an OpenRouter model slug.
# The free-model decision covers text and vision models only; the voice
# feature (POST /api/v1/catalog/voice) needs a real Sarvam key to run.
# Without SARVAM_API_KEY the other two AI features are unaffected.
SARVAM_API_KEY=your-sarvam-api-key
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saaras:v3

# Storage
SUPABASE_STORAGE_BUCKET=product-images

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
